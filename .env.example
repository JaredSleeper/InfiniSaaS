DATABASE_URL=postgresql://postgres:password@localhost:5433/infinisaas
LOG_LEVEL=INFO
PUBLIC_URL=

# Encrypts integration secrets at rest (pgcrypto). Set a long random value in prod.
SECRETS_KEY=dev-only-change-me

# Auth (Clerk). Leave CLERK_JWKS_URL empty to run without auth locally.
CLERK_JWKS_URL=
CLERK_PUBLISHABLE_KEY=
ALLOWED_EMAILS=

# Agents / Devin / Railway ops. All optional; mock mode when empty.
ANTHROPIC_API_KEY=
DEVIN_API_KEY=
RAILWAY_API_TOKEN=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
